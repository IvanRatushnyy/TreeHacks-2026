# Copy to .env and fill in. Do not commit .env.

# App
ENV=development
PORT=8000

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# PII: optional external redaction service (else in-app regex fallback)
# PII_SERVICE_URL=http://localhost:5001

# LLM: Claude (primary), OpenAI (fallback). PII/Voice are in-app on same EC2.
# TTS: human-like voice uses OpenAI TTS when OPENAI_API_KEY is set (POST /api/tts).
# Optional: TTS_VOICE=marin (or cedar, coral, nova, shimmer; marin/cedar best with gpt-4o-mini-tts)
# Optional: TTS_MODEL=gpt-4o-mini-tts (supports "instructions" for natural tone; else tts-1-hd)
# Optional: TTS_INSTRUCTIONS=Speak in a warm, natural tone. Calm pace.
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=claude

# S3
# AWS_REGION=us-east-1
# SAGING_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB: optional table for logging summary records (masked patient → S3 key)
# SAGING_DDB_TABLE=saging-summary-records

# Optional: AWS Secrets Manager (JSON: CLAUDE_API_KEY, OPENAI_API_KEY, SAGING_S3_BUCKET)
# USE_AWS_SECRETS=0
# SAGING_SECRETS_NAME=
